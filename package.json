{
  "name": "subscription-tracker",
  "version": "1.0.0",
  "description": "Personal Subscription & Expense Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "subscription",
    "tracker",
    "expense",
    "finance"
  ],
  "author": "Subscription Tracker App",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.subscription.tracker",
    "productName": "Subscription Tracker",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}